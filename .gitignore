external/
*.addon64
dist/*.dll
__pycache__/

# Generated from the snippet installed on the build machine, and derived from
# NVIDIA's own PTX -- rebuild it with tools/rebuild_cubins.py, never commit it.
src/cubins.h

# The Streamline set embedded as bytes (tools/embed_sdk.py): NVIDIA binaries,
# 5 MB, rebuilt from the SDK zip or the cache. Never commit them.
src/sdk_blob.S
src/sdk_manifest.h
build/

# Build output and logs
version.dll
*.log
*.exe

# Official Streamline SDK binaries, downloaded to give tools/verify_patches.py
# a corpus to run every signature against. NVIDIA's to distribute, not ours,
# and 54 MB that git would keep forever.
corpus/

# Release artefacts belong on GitHub Releases. Keeping a built dll here is also
# how a stale one survived long enough to be shipped: releases/v1.0/version.dll
# was built from sources predating the fix that src/ already had.
releases/
